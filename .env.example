# 复制这个文件为 .env，然后按需修改
# 命令：copy .env.example .env

# 会话加密用的密钥。上线前必须换成随机字符串！
# 生成方法：python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-only-change-me

# SQLite 数据库文件路径，相对路径以项目根目录为基准
DATABASE_PATH=wrongbook.db

# 1 = 开启调试模式（改代码自动重启、显示详细报错）；上线时必须是 0
FLASK_DEBUG=1

# ---------------- AI 诊断（可选）----------------
# 不填的话，详情页不会显示【AI 诊断】按钮，其他功能完全正常。
# 去阿里云百炼控制台创建 API-KEY：https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=

# 用哪个模型。qwen-plus 够用且便宜，qwen-turbo 更便宜
AI_MODEL=qwen-plus
